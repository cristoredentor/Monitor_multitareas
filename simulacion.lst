 632  1C5B              ;***************************************************************************
 633  1C5B              ;
 634  1C5B              ; PRIMITIVE CREER(@DEBUT,ACTX)                    CREATION CTX
 635  1C5B                                                      ; crea una tarea nueva a partir de una dirección de inicio de
 636  1C5B                                                      ; código (@DEBUT); usa el siguiente bloque libre de INICTX
 637  1C5B
 638  1C5B F3           CREER           DI
 639  1C5C
 640  1C5C DD E5                        PUSH    IX
 641  1C5E E5                           PUSH    HL
 642  1C5F D5                           PUSH    DE
 643  1C60 E5                           PUSH    HL                       ; se guarda @DEBUT dos veces: una para usarla ya,
 644  1C61                                                      ; otra para recuperarla más abajo
 645  1C61
 646  1C61 DD 2A 04 10                  LD      IX,(PTRCTXL)             ; IX POINTE CTX LIBRE
 647  1C65
 648  1C65 2A 04 10                     LD      HL,(PTRCTXL)
 649  1C68 1E 6A                        LD      E,LONGDCTX
 650  1C6A 16 00                        LD      D,0
 651  1C6C 19                           ADD     HL,DE                    ; HL POINTE CTX SUIVANT
 652  1C6D 22 04 10                     LD      (PTRCTXL),HL             ; ACTUALISATION PTRCTXL
 653  1C70
 654  1C70 2B                           DEC     HL                       ; HL POINTE FOND FILE
 655  1C71                                                      ; HL queda apuntando al ÚLTIMO byte del bloque recién
 656  1C71                                                      ; reservado (el fondo de la pila de esta tarea, ya que la
 657  1C71                                                      ; pila del Z80 crece hacia direcciones menores)
 658  1C71 EB                           EX      DE,HL
 659  1C72 E1                           POP     HL
 660  1C73 E5                           PUSH    HL                       ; @ DEBUT PGM
 661  1C74 EB                           EX      DE,HL
 662  1C75 72                           LD      (HL),D                   ; DE = @ DEBUT PGM
 663  1C76 2B                           DEC     HL
 664  1C77 73                           LD      (HL),E                   ; @ DEBUT AU FOND PILE
 665  1C78                                                      ; escribe la dirección de inicio del programa (@DEBUT) al
 666  1C78                                                      ; fondo de la pila de la nueva tarea, para que el DISPATCHER
 667  1C78                                                      ; "salte" ahí (con su POP+RET/POP AF final) la primera vez
 668  1C78 06 06                        LD      B,6                      ; INITIALISATION REGISTRES A 0
 669  1C7A 2B           INIREG          DEC     HL
 670  1C7B 36 00                        LD      (HL),0
 671  1C7D 2B                           DEC     HL
 672  1C7E 36 00                        LD      (HL),0
 673  1C80 10 F8                        DJNZ    INIREG
 674  1C82                                                      ; inicializa en 0 los 6 registros de 16 bits restantes
 675  1C82                                                      ; (AF,BC,DE,HL,IX,IY) que DISP hará POP la primera vez
 676  1C82
 677  1C82 DD 75 04                     LD      (IX + GARSP),L
 678  1C85 DD 74 05                     LD      (IX + GARSP + 1),H      ; INITIALISATION SP -> guarda el SP inicial de la
 679  1C88                                                      ; tarea, apuntando al tope de su pila ya preparada
 680  1C88
 681  1C88 DD 36 02 01                  LD      (IX + STATUS),PRET       ; ETAT = PRET -> la tarea nace lista para ejecutar
 682  1C8C
 683  1C8C DD 36 00 00                  LD      (IX + CHTPMS),NIL        ; CHAINAGE TACHES PRETES
 684  1C90 DD 36 01 00                  LD      (IX + CHTPMS + 1),NIL
 685  1C94 3A 06 10                     LD      A,(NBCTX)
 686  1C97 B7                           OR      A                        ; FILE VIDE ?
 687  1C98 20 0A                        JR      NZ,FTPNV
 688  1C9A DD 22 08 10                  LD      (PTRDTP),IX              ; FILE VIDE -> es la primera tarea: ella misma es
 689  1C9E DD 22 0A 10                  LD      (PTRFTP),IX              ; cabeza y cola de la cola de listas
 690  1CA2 18 11                        JR      SUITCREAR
 691  1CA4 DD E5        FTPNV           PUSH    IX                       ; FILE NON VIDE -> ya había tareas: se agrega al
 692  1CA6 D1                           POP     DE                       ; DE POINTE CTX A CREER   final de la cola
 693  1CA7 DD 2A 0A 10                  LD      IX,(PTRFTP)              ; IX POINTE DERNIERE PRETE
 694  1CAB DD 73 00                     LD      (IX + CHTPMS),E
 695  1CAE DD 72 01                     LD      (IX + CHTPMS + 1),D
 696  1CB1 ED 53 0A 10                  LD      (PTRFTP),DE
 697  1CB5
 698  1CB5 E1           SUITCREAR       POP     HL
 699  1CB6 D1                           POP     DE
 700  1CB7 C1                           POP     BC
 701  1CB8 DD E1                        POP     IX
 702  1CBA
 703  1CBA 3A 06 10                     LD      A,(NBCTX)
 704  1CBD 3C                           INC     A
 705  1CBE 32 06 10                     LD      (NBCTX),A                ; incrementa el contador global de tareas creadas
 706  1CC1
 707  1CC1 FB                           EI
 708  1CC2 C9                           RET
 709  1CC3
 710  1CC3
 711  1CC3              ;***************************************************************************
 712  1CC3              ;
 713  1CC3              ; PRIMITIVE DETRUIX(#CTX)                          -> destruye una tarea existente
 714  1CC3                                                                ; #CTX > 0
 715  1CC3 F3           DETRUIX         DI
 716  1CC4
 717  1CC4 F5                           PUSH    AF
 718  1CC5 E5                           PUSH    HL
 719  1CC6 D5                           PUSH    DE
 720  1CC7 C5                           PUSH    BC
 721  1CC8 DD E5                        PUSH    IX
 722  1CCA FD E5                        PUSH    IY
 723  1CCC
 724  1CCC 21 EE 10                     LD      HL,INICTX                ; RECHERCHE CTX
 725  1CCF 1E 6A                        LD      E,LONGDCTX
 726  1CD1 16 00                        LD      D,0
 727  1CD3 47                           LD      B,A
 728  1CD4 19           BUSCTX          ADD     HL,DE
 729  1CD5 10 FD                        DJNZ    BUSCTX                    ; HL POINTE CTX A DETRUIRE
 730  1CD7                                                      ; recorre INICTX en pasos de LONGDCTX (tamaño total del bloque)
 731  1CD7                                                      ; para llegar al bloque de la tarea #A.
 732  1CD7 4D                           LD      C,L
 733  1CD8 44                           LD      B,H
 734  1CD9 C5                           PUSH    BC
 735  1CDA DD E1                        POP     IX                        ; BC,IX POINTENT A CTX
 736  1CDC
 737  1CDC DD 7E 02                     LD      A,(IX + STATUS)
 738  1CDF DD 36 02 00                  LD      (IX + STATUS),NONCREE
 739  1CE3 FE 03                        CP      BLOQUEO                    ; TACHE BLOQUEE ?
 740  1CE5 28 14                        JR      Z,TCHBLQ
 741  1CE7
 742  1CE7 CD 5F 1D                     CALL    DECHAIN                   ; TACHE PRETE, DECHAINAGE
 743  1CEA DD 7E 00                     LD      A,(IX + CHTPMS)           ; DERNIERE ?
 744  1CED DD B6 01                     OR      (IX + CHTPMS + 1)
 745  1CF0 20 63                        JR      NZ,FINDET                 ; PAS DERNIERE
 746  1CF2 FD E5                        PUSH    IY                        ; DERNIERE
 747  1CF4 D1                           POP     DE
 748  1CF5 ED 53 0A 10                  LD      (PTRFTP),DE
 749  1CF9 18 5A                        JR      FINDET
 750  1CFB
 751  1CFB DD 7E 03     TCHBLQ          LD      A,(IX + SEMAT)            ; TACHE BLOQUEE
 752  1CFE CD 89 1A                     CALL    RECHSEM
 753  1D01 EB                           EX      DE,HL
 754  1D02 D5                           PUSH    DE
 755  1D03 FD E1                        POP     IY                        ; DE,IY POINTENT SEMAPHORE
 756  1D05
 757  1D05 FD 34 00                     INC     (IY + 0)                  ; OPTEUR = OPTEUR + 1
 758  1D08 20 16                        JR      NZ,NOVIDBL                ; FILE VIDE ?
 759  1D0A
 760  1D0A FD 36 01 00                  LD      (IY + 1),NIL              ; FILE VIDE
 761  1D0E FD 36 02 00                  LD      (IY + 2),NIL
 762  1D12 FD 36 03 00                  LD      (IY + 3),NIL
 763  1D16 FD 36 04 00                  LD      (IY + 4),NIL
 764  1D1A FD 36 05 00                  LD      (IY + 5),FALSE
 765  1D1E 18 35                        JR      FINDET
 766  1D20
 767  1D20 FD 6E 01     NOVIDBL         LD      L,(IY + 1)                ; FILE NON VIDE
 768  1D23 FD 66 02                     LD      H,(IY + 2)                ; EN TETE ?
 769  1D26 7D                           LD      A,L
 770  1D27 FE 00                        CP      0
 771  1D29 20 0E                        JR      NZ,STELIM
 772  1D2B
 773  1D2B DD 7E 00                     LD      A,(IX + CHTPMS)           ; EN TETE
 774  1D2E FD 77 01                     LD      (IY + 1),A
 775  1D31 DD 7E 01                     LD      A,(IX + CHTPMS + 1)      ; (IY+1)/(IY+2) = puntero de 16 bits a la cabeza de
 776  1D34 FD 77 02                     LD      (IY + 2),A                ; la cola de espera: el byte alto va en (IY+2)
 777  1D37 18 05                        JR      ULTFIL
 778  1D39
 779  1D39 FD E5        STELIM          PUSH    IY                        ; PAS EN TETE, GARDER PTR SEM
 780  1D3B CD 5F 1D                     CALL    DECHAIN                    ; DECHAINAGE
 781  1D3E
 782  1D3E DD 7E 00     ULTFIL          LD      A,(IX + CHTPMS)            ; DERNIERE ?
 783  1D41 DD B6 01                     OR      (IX + CHTPMS + 1)
 784  1D44 20 0D                        JR      NZ,FINDET1
 785  1D46
 786  1D46 FD E5                        PUSH    IY                          ; DERNIERE
 787  1D48 D1                           POP     DE                          ; DE POINTE NOUVELLE DERNIERE
 788  1D49 FD E1                        POP     IY                          ; RECUPERATION PTR SEMAPHORE
 789  1D4B FD 73 03                     LD      (IY + 3),E
 790  1D4E FD 72 04                     LD      (IY + 4),D                  ; NOUVEAU CHAINAGE
 791  1D51 18 02                        JR      FINDET
 792  1D53
 793  1D53 FD E1        FINDET1         POP     IY                          ; RECUPERATION PTR SEMAPHORE
 794  1D55
 795  1D55 FD E1        FINDET          POP     IY
 796  1D57 DD E1                        POP     IX
 797  1D59 C1                           POP     BC
 798  1D5A D1                           POP     DE
 799  1D5B E1                           POP     HL
 800  1D5C F1                           POP     AF
 801  1D5D
 802  1D5D FB                           EI
 803  1D5E C9                           RET
 804  1D5F
 805  1D5F
 806  1D5F              ;
 807  1D5F              ; SOUSPROGRAMME DECHAIN
 808  1D5F              ;                         FAIT LE DECHAINAGE DE LA TACHE A DETRUIRE
 809  1D5F              ;                         CETTE TACHE NE DOIT PAS ETRE AU DEBUT D'UNE FILE
 810  1D5F              ;
 811  1D5F              ;                         IX,BC DOIVENT POINTER TACHE A DECHAINER
 812  1D5F              ;                         IY POINTE TACHE QUI POINTE TACHE A DETRUIRE
 813  1D5F              ;                         A LA SORTIE
 814  1D5F              ;                         AF,HL,DE SONT DETRUITS
 815  1D5F
 816  1D5F FD 21 EE 10  DECHAIN         LD      IY,INICTX
 817  1D63 1E 6A                        LD      E,LONGDCTX               ; paso entre bloques = tamaño TOTAL del bloque
 818  1D65 16 00                        LD      D,0
 819  1D67
 820  1D67 FD 6E 00     BOUX            LD      L,(IY + CHTPMS)             ; RECHERCHE CTX QUI POINTE
 821  1D6A FD 66 01                     LD      H,(IY + CHTPMS + 1)         ;   CTX A DECHAINER
 822  1D6D 79                           LD      A,C
 823  1D6E BD                           CP      L
 824  1D6F 20 04                        JR      NZ,ADDIX
 825  1D71 78                           LD      A,B
 826  1D72 BC                           CP      H
 827  1D73 28 04                        JR      Z,TROUVE                    ; ¿el puntero "siguiente" de este bloque
 828  1D75                                                      ; coincide con la dirección de la tarea buscada (BC)?
 829  1D75 FD 19        ADDIX           ADD     IY,DE                        ; si no, avanza al siguiente bloque de INICTX
 830  1D77 18 EE                        JR      BOUX
 831  1D79
 832  1D79 DD 7E 00     TROUVE          LD      A,(IX + CHTPMS)              ; TROUVE, DECHAINAGE
 833  1D7C FD 77 00                     LD      (IY + CHTPMS),A
 834  1D7F DD 7E 01                     LD      A,(IX + CHTPMS + 1)
 835  1D82 FD 77 01                     LD      (IY + CHTPMS + 1),A
 836  1D85
 837  1D85 C9                           RET
 838  1D86
 839  1D86
 840  1D86              ;***************************************************************************
 841  1D86              ;
 842  1D86              ; INITIALISATION MONITEUR
 843  1D86              ;
 844  1D86 F3           DEBMON          DI
 845  1D87
 846  1D87 31 5C 19                     LD      SP,PPILSYS                ; INITIALISATION SP -> usa la pila de arranque
 847  1D8A                                                      ; del sistema (PILSYS), la única que existe antes de crear
 848  1D8A                                                      ; ninguna tarea
 849  1D8A
 850  1D8A 21 5F 19                     LD      HL,CONSBUF
 851  1D8D 22 27 1A                     LD      (CONSPTR),HL              ; INITIALISATION CONSOLA SIMULADA
 852  1D90
 853  1D90 3E 00                        LD      A,0
 854  1D92 32 06 10                     LD      (NBCTX),A                 ; INITIALISATION NB CTX -> todavía no hay tareas
 855  1D95
 856  1D95 21 EE 10                     LD      HL,INICTX
 857  1D98 22 04 10                     LD      (PTRCTXL),HL              ; INITIALISATION PTR CTX -> el primer bloque
 858  1D9B                                                      ; libre es el principio de la tabla de contextos
 859  1D9B
 860  1D9B 22 0C 10                     LD      (PTRTA),HL                ; TACHE ACTIVE = TACHE FOND
 861  1D9E 21 A7 1D                     LD      HL,TACHFON                ; CREATION TACHE FOND
 862  1DA1 CD 5B 1C                     CALL    CREER
 863  1DA4
 864  1DA4 C3 2E 1B                     JP      DISPP                     ; ACTIVATION TACHE FOND -> arranca todo activando
 865  1DA7                                                      ; la primera (y única, por ahora) tarea que existe
 866  1DA7                                                      ; [FIX] Antes decía "JP DISP". DISP arranca guardando el
 867  1DA7                                                      ; contexto de "la tarea actual" (PTRTA) antes de restaurar el
 868  1DA7                                                      ; de la cabeza de la cola de listas (PTRDTP). Aquí, en el
 869  1DA7                                                      ; arranque, PTRTA y PTRDTP apuntan al MISMO bloque (la única
 870  1DA7                                                      ; tarea que existe hasta ahora), así que ese "guardado" pisaba
 871  1DA7                                                      ; el GARSP que CREER acababa de preparar (con la pila privada
 872  1DA7                                                      ; correcta de TACHFON) con el SP de arranque (PPILSYS, en
 873  1DA7                                                      ; ceros), y el RET final terminaba saltando a 0000H. Saltando
 874  1DA7                                                      ; directo a DISPP se evita ese guardado innecesario: no hay
 875  1DA7                                                      ; ninguna tarea previa real cuyo contexto haya que preservar.
 876  1DA7                                                      ; (Los otros dos "JP DISP", en WAIT y PASS, sí son correctos:
 877  1DA7                                                      ; ahí PTRTA y PTRDTP ya son bloques distintos.)
 878  1DA7
 879  1DA7
 880  1DA7              ;***************************************************************************
 881  1DA7              ;
 882  1DA7              ; TACHE DE FOND                                    -> tarea de fondo: prepara periféricos,
 883  1DA7              ;                                                     arma el time-slicing y crea las tareas T1..T3
 884  1DA7              ;
 885  1DA7 CD CC 1D     TACHFON         CALL    INIPER                    ; INIT PERIPHERIQUES
 886  1DAA
 887  1DAA 01 02 00                     LD      BC,0002H
 888  1DAD 3E 00                        LD      A,0
 889  1DAF CD FF 1B                     CALL    ARMERH                    ; TIME SLICING -> arma (con cuenta chica) y activa
 890  1DB2 CD 29 1C                     CALL    ACTIVH                    ; el watchdog de la unidad 0, reservada para el
 891  1DB5                                                      ; reparto de CPU por tiempo (ver comentario en PASS y RTITCTC)
 892  1DB5
 893  1DB5 21 AE 1E                     LD      HL,T1                      ; CREATION TACHE 1
 894  1DB8 CD 5B 1C                     CALL    CREER
 895  1DBB 21 CD 1E                     LD      HL,T2                      ; CREATION TACHE 2
 896  1DBE CD 5B 1C                     CALL    CREER
 897  1DC1 21 EC 1E                     LD      HL,T3                      ; CREATION TACHE 3
 898  1DC4 CD 5B 1C                     CALL    CREER
 899  1DC7
 900  1DC7 CD 4C 1B     SIEMPRE         CALL    PASS                       ; BOUCLE TOUJOURS
 901  1DCA 18 FB                        JR      SIEMPRE
 902  1DCC                                                      ; la tarea de fondo se convierte en la tarea "idle": cede la
 903  1DCC                                                      ; CPU una y otra vez a quien esté listo, para siempre
 904  1DCC
 905  1DCC
 906  1DCC              ;
 907  1DCC 21 5D 19     INIPER          LD      HL,TARTIT                  ; INITIALISATION REGISTRE I
 908  1DCF 7C                           LD      A,H                        ; carga en el registro I la página alta de la
 909  1DD0 ED 47                        LD      I,A                        ; tabla de vectores (modo IM 2 del Z80)
 910  1DD2
 911  1DD2 CD E3 1D                     CALL    INICTC                     ; INITIALISATION CTC
 912  1DD5 CD DC 1D                     CALL    INVSIO                     ; INVALIDATION IT SIO
 913  1DD8
 914  1DD8 ED 5E                        IM      2                          ; modo de interrupción 2: usa tabla de vectores
 915  1DDA FB                           EI
 916  1DDB C9                           RET
 917  1DDC
 918  1DDC
 919  1DDC              ;
 920  1DDC              ; INVALIDATION IT SIO
 921  1DDC              ;
 922  1DDC 3E D0        INVSIO          LD      A,0D0H                    ; deshabilita las interrupciones del chip SIO
 923  1DDE D3 79                        OUT     (079H),A                   ; (no se usa en este programa)
 924  1DE0 D3 7B                        OUT     (07BH),A
 925  1DE2 C9                           RET
 926  1DE3
 927  1DE3
 928  1DE3              ;
 929  1DE3              ; INITIALISATION CTC
 930  1DE3              ;
 931  1DE3 21 5D 19     INICTC          LD      HL,TARTIT
 932  1DE6 11 0B 1E                     LD      DE,RTITCTC
 933  1DE9 73                           LD      (HL),E                     ; @ ROUTINE TRAITEMENTS D'IT DU
 934  1DEA 23                           INC     HL                          ; CTC A LA TABLE D'ADRESSES IT
 935  1DEB 72                           LD      (HL),D
 936  1DEC                                                      ; registra la dirección de RTITCTC (la rutina de interrupción
 937  1DEC                                                      ; del CTC) en la tabla de vectores TARTIT
 938  1DEC
 939  1DEC DD 21 0E 10                  LD      IX,BSEM
 940  1DF0 1E 08                        LD      E,8                          ; cada entrada de BSEM mide 8 bytes
 941  1DF2 16 00                        LD      D,0
 942  1DF4 06 1C                        LD      B,SEMPES
 943  1DF6 DD 36 05 00  FS              LD      (IX + 5),FALSE              ; T.D. INACTIFS
 944  1DFA DD 19                        ADD     IX,DE
 945  1DFC 10 F8                        DJNZ    FS
 946  1DFE                                                      ; deja todos los watchdogs (temporizadores) de todos los
 947  1DFE                                                      ; semáforos inactivos al arrancar
 948  1DFE
 949  1DFE 3E 00                        LD      A,0
