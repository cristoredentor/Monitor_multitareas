 579  1C29
 580  1C29 F3           ACTIVH          DI
 581  1C2A
 582  1C2A F5                           PUSH    AF
 583  1C2B E5                           PUSH    HL
 584  1C2C D5                           PUSH    DE
 585  1C2D DD E5                        PUSH    IX
 586  1C2F
