 423  1B92              ;***************************************************************************
 424  1B92              ;
 425  1B92              ; PRIMITIVE DEMES(#UNITE)                        DEMANDE E/S
 426  1B92                                                      ; pide una E/S: equivale a un P() sobre el semáforo de esa
 427  1B92                                                      ; unidad de E/S (los semáforos de E/S viven después de los
 428  1B92                                                      ; NBSEM normales dentro de la misma tabla BSEM)
 429  1B92              ;
 430  1B92 F3           DEMES           DI
 431  1B93
 432  1B93 C6 14                        ADD     A,NBSEM
 433  1B95 C3 29 1A                     JP      SEMP                     ; PRIMITIVE P
 434  1B98
 435  1B98
 436  1B98              ;***************************************************************************
 437  1B98              ;                                                 SIGNAL NON MEMORISE
 438  1B98                                                      ; señala que una E/S terminó: equivale a un V(), pero además
 439  1B98                                                      ; apaga el watchdog de esa unidad y anota que no fue el reloj
 440  1B98                                                      ; quien la despertó
 441  1B98              ;                                                 A NON DETRUIT A LA SORTIE
 442  1B98 F3           FINES           DI
 443  1B99
 444  1B99 E5                           PUSH    HL
 445  1B9A D5                           PUSH    DE
 446  1B9B DD E5                        PUSH    IX
 447  1B9D
 448  1B9D 5F                           LD      E,A
 449  1B9E 16 00                        LD      D,0
 450  1BA0 21 36 19                     LD      HL,INREVM
 451  1BA3 19                           ADD     HL,DE
 452  1BA4 36 00                        LD      (HL),FALSE                ; NON REVEILLE PAR HORLOGE
 453  1BA6                                                      ; marca que ESTA E/S no fue despertada por el reloj (sino
 454  1BA6                                                      ; por un FINES llamado a mano, como aquí)
 455  1BA6
 456  1BA6 C6 14                        ADD     A,NBSEM
 457  1BA8 F5                           PUSH    AF
 458  1BA9 CD 89 1A                     CALL    RECHSEM                  ; ubica el semáforo de E/S correspondiente
 459  1BAC E5                           PUSH    HL
 460  1BAD DD E1                        POP     IX                       ; IX POINTE SEMAPHORE
 461  1BAF DD 36 05 00                  LD      (IX + 5),FALSE            ; INHIBITION T.D. -> apaga su watchdog
 462  1BB3 DD 7E 00                     LD      A,(IX + 0)               ; A = OPTEUR SEMAPHORE
 463  1BB6 B7                           OR      A
 464  1BB7 FA C1 1B                     JP      M,APV
 465  1BBA                                                      ; [FIX] Antes decía "JP Z,APV" (saltaba cuando el contador
 466  1BBA                                                      ; era EXACTAMENTE 0). Pero INIES arranca el contador en 0, y
 467  1BBA                                                      ; DEMES (P) lo deja en NEGATIVO cuando alguien queda esperando
 468  1BBA                                                      ; (0 -> -1 con el primer DEMES). O sea que "ya había una tarea
 469  1BBA                                                      ; esperando" se detecta con el contador NEGATIVO, no en 0: con
 470  1BBA                                                      ; la condición original, FINES hacía el V() completo (SIGNAL)
 471  1BBA                                                      ; justo cuando NADIE esperaba, e ignoraba la señal (sin llamar
 472  1BBA                                                      ; a SIGNAL) cuando SÍ había una tarea bloqueada esperándola -
 473  1BBA                                                      ; exactamente al revés de lo que dice el propio comentario y
 474  1BBA                                                      ; el nombre de la rutina (SIGNAL NON MEMORISE). Con "JP M,APV"
 475  1BBA                                                      ; se dispara SIGNAL cuando el contador es negativo (alguien
 476  1BBA                                                      ; esperando) y se descarta la señal cuando es 0 (nadie
 477  1BBA                                                      ; esperando), que es el comportamiento "no memorizado" real.
 478  1BBA
 479  1BBA F1                           POP     AF                       ; si no había nadie esperando, basta con
 480  1BBB DD E1                        POP     IX                       ; salir sin tocar las colas
 481  1BBD D1                           POP     DE
 482  1BBE E1                           POP     HL
 483  1BBF
 484  1BBF FB                           EI
 485  1BC0 C9                           RET
 486  1BC1
 487  1BC1 F1           APV             POP     AF
 488  1BC2 DD E1                        POP     IX
 489  1BC4 D1                           POP     DE
 490  1BC5 E1                           POP     HL
 491  1BC6
 492  1BC6 C3 94 1A                     JP      V
 493  1BC9                                                      ; A ya trae el número de semáforo correcto: reutiliza V
 494  1BC9
 495  1BC9
