 216  1A89              ;
 217  1A89              ; SOUSPROGRAMME RECHSEM     ENTREE   A=#SEMAPHORE
 218  1A89              ;                           SORTIE   HL=@ SEMAPHORE
 219  1A89              ;
 220  1A89 07           RECHSEM         RLCA
 221  1A8A 07                           RLCA
 222  1A8B 07                           RLCA                             ; MULT. PAR 8
 223  1A8C                                                      ; (rotar 3 veces a la izquierda = multiplicar por 8; cada
 224  1A8C                                                      ; semáforo en BSEM ocupa 8 bytes)
 225  1A8C 5F                           LD      E,A
 226  1A8D 16 00                        LD      D,0
 227  1A8F 21 0E 10                     LD      HL,BSEM
 228  1A92 19                           ADD     HL,DE                    ; HL = BSEM + (número de semáforo * 8)
 229  1A93 C9                           RET
