 206  1519              ; PRIMITIVE V(#SEMAPHORE)                  -> operación V (signal) de Dijkstra
 207  1519              ;
 208  1519 F3           V               DI
 209  151A
 210  151A F5                           PUSH    AF
 211  151B E5                           PUSH    HL
 212  151C D5                           PUSH    DE
 213  151D
 214  151D CD 0E 15                     CALL    RECHSEM                  ; HL POINTE SEMAPHORE
 215  1520
 216  1520 34                           INC     (HL)
 217  1521                                                        ; OPTEUR = OPTEUR + 1
 218  1521
 219  1521 FA 2A 15                     JP      M,SIGNAL
 220  1524 CA 2A 15                     JP      Z,SIGNAL                 ; DEBLOCAGE D'UNE TACHE
 221  1527                                                      ; si tras incrementar quedó negativo o -1 manda signal
 222  1527
 223  1527 C3 72 15                     JP      FINV                     ; CONTINUER
 224  152A
 225  152A
 226  152A E5           SIGNAL          PUSH    HL
 227  152B FD E1                        POP     IY                       ; IY POINTE SEMAPHORE
 228  152D
 229  152D FD 5E 01                     LD      E,(IY + 1)
 230  1530 FD 56 02                     LD      D,(IY + 2)               ; EXTRAIRE 1 CTX FILE SEM
 231  1533 D5                           PUSH    DE
 232  1534 DD E1                        POP     IX                       ; DE,IX POINTENT TACHE DEBLOQ
 233  1536                                                      ; IX/DE = la tarea que estaba en la CABEZA de la cola de
 234  1536                                                      ; espera del semáforo: es la que se va a desbloquear
 235  1536
 236  1536 7E                           LD      A,(HL)
 237  1537 B7                           OR      A
 238  1538 20 12                        JR      NZ,NOVIDEV
 239  153A FD 36 01 00                  LD      (IY + 1),NIL
 240  153E FD 36 02 00                  LD      (IY + 2),NIL
 241  1542 FD 36 03 00                  LD      (IY + 3),NIL
 242  1546 FD 36 04 00                  LD      (IY + 4),NIL             ; LA FILE EST VIDE
 243  154A                                                      ; el contador quedó en 0: no queda nadie más esperando,
 244  154A                                                      ; se limpian todos los punteros de la cola de espera
 245  154A 18 0C                        JR      CONTV
 246  154C DD 6E 00     NOVIDEV         LD      L,(IX + CHTPMS)
 247  154F DD 66 01                     LD      H,(IX + CHTPMS + 1)      ; LA FILE N'EST PAS VIDE
 248  1552 FD 75 01                     LD      (IY + 1),L
 249  1555 FD 74 02                     LD      (IY + 2),H               ; CHAINAGE FILE
 250  1558                                                      ; todavía queda alguien esperando: avanza la cabeza de la
 251  1558                                                      ; cola de espera al que era "siguiente" de la tarea desbloq.
 252  1558
 253  1558 DD 36 00 00  CONTV           LD      (IX + CHTPMS),NIL        ; AJOUTER A FILE TACHES PRETES
 254  155C DD 36 01 00                  LD      (IX + CHTPMS + 1),NIL
 255  1560 DD 36 02 01                  LD      (IX + STATUS),PRET
 256  1564                                                      ; la tarea desbloqueada se agrega al FINAL de la cola de
 257  1564                                                      ; tareas listas (vuelve a competir por CPU normalmente)
 258  1564
 259  1564 DD 2A 0A 10                  LD      IX,(PTRFTP)              ; IX POINTE DERNIERE PRETE
 260  1568 DD 73 00                     LD      (IX + CHTPMS),E
 261  156B DD 72 01                     LD      (IX + CHTPMS + 1),D
 262  156E ED 53 0A 10                  LD      (PTRFTP),DE
