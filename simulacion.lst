 121  14B1              ; PRIMITIVE P(#SEMAPHORE)
 122  14B1                                                      ; se usa el nombre "SEMP" en vez de "P": "P" es la condición
 123  14B1                                                      ; de signo positivo del Z80 y choca con instrucciones como
 124  14B1                                                      ; "JP P,..." (ver su uso en DEMES, más abajo)
 125  14B1 F3           SEMP            DI
 126  14B2
 127  14B2
 128  14B2 F5                           PUSH    AF                       ; se guardan los registros que esta rutina toca,
 129  14B3 E5                           PUSH    HL                       ; para poder restaurarlos intactos si al final
 130  14B4 D5                           PUSH    DE                       ; resulta que NO hubo que bloquear la tarea
 131  14B5 C5                           PUSH    BC
 132  14B6
 133  14B6 47                           LD      B,A                      ; guarda el número de semáforo en B, porque
 134  14B7                                                      ; RECHSEM va a destruir el valor de A
 135  14B7
 136  14B7 CD 0E 15                     CALL    RECHSEM                  ; HL POINTE SEMAPHORE
 137  14BA 35                           DEC (HL)
 138  14BB FA C4 14                     JP      M,WAIT                   ; SI OPTEUR < 0 ALORS WAIT
 139  14BE                                                               ; si el contador quedó negativo, no había recurso libre:
 140  14BE                                                               ; bloquear la tarea actual (saltar a WAIT)
 141  14BE
 142  14BE C1                           POP     BC                       ; NON BLOQUEE, CONTINUER
 143  14BF D1                           POP     DE                       ; sí había recurso disponible: se restauran los
 144  14C0 E1                           POP     HL                       ; registros tal cual estaban y se sigue de largo,
 145  14C1 F1                           POP     AF                       ; sin cambiar de tarea
 146  14C2
 147  14C2 FB                           EI
 148  14C3 C9                           RET
 149  14C4
 150  14C4 DD E5        WAIT            PUSH    IX                       ; BLOCAGE TACHE EXECUTANT P
 151  14C6 FD E5                        PUSH    IY
 152  14C8
 153  14C8 EB                           EX      DE,HL                    ; ahora DE apunta al semáforo (antes en HL)
 154  14C9 D5                           PUSH    DE
 155  14CA FD E1                        POP     IY                       ; DE,IY POINTENT SEMAPHORE
 156  14CC
 157  14CC DD 2A 0C 10                  LD      IX,(PTRTA)               ; IX POINTE CTX TACHE EN COURS
 158  14D0
 159  14D0 DD 6E 00                     LD      L,(IX + CHTPMS)          ; EXTRAIRE TETE TACHES PRETES
 160  14D3 DD 66 01                     LD      H,(IX + CHTPMS + 1)      ; toma quién era "el siguiente" de la tarea actual
 161  14D6 22 08 10                     LD      (PTRDTP),HL              ; y lo hace la nueva cabeza de la cola de listas
 162  14D9
 163  14D9 DD 36 00 00                  LD      (IX + CHTPMS),NIL        ; AJOUTER A TETE ATTENTE SEM
 164  14DD DD 36 01 00                  LD      (IX + CHTPMS + 1),NIL    ; (se limpia el puntero de encadenamiento; se fija
 165  14E1 DD 36 02 03                  LD      (IX + STATUS),BLOQUEO    ; según si la cola del semáforo está vacía o no,
 166  14E5 DD 70 03                     LD      (IX + SEMAT),B           ; más abajo). Guarda en qué semáforo quedó (B).
 167  14E8
 168  14E8 FD 7E 01                     LD      A,(IY + 1)               ; (IY+1) = byte bajo de la cabeza de la cola espera
 169  14EB A7                           AND     A                        ; A = A-T-IL FALLU BLOQUER ? (en realidad prueba si
 170  14EC 20 08                        JR      NZ,NOVIDER               ; la cola de espera del semáforo ya tenía tareas)
 171  14EE
 172  14EE FD 73 01                     LD      (IY + 1),E               ; FILE VIDE -> la cola estaba vacía: esta tarea
 173  14F1 FD 72 02                     LD      (IY + 2),D               ; PTR DEBUT FILE   pasa a ser cabeza Y cola a la vez
 174  14F4 18 0F                        JR      CONTW
 175  14F6 FD 6E 03     NOVIDER         LD      L,(IY + 3)               ; la cola no estaba vacía: toma la última tarea que
 176  14F9 FD 66 04                     LD      H,(IY + 4)               ; ya esperaba en este semáforo...
 177  14FC E5                           PUSH    HL
 178  14FD DD E1                        POP     IX
 179  14FF DD 73 00                     LD      (IX + CHTPMS),E
 180  1502 DD 72 01                     LD      (IX + CHTPMS + 1),D      ; CHAINAGE  (...y hace que esa última apunte ahora
 181  1505                                                      ; a la tarea que se acaba de bloquear)
 182  1505 FD 73 03     CONTW           LD      (IY + 3),E               ; PTR FIN FILE -> en ambos casos, actualiza el
 183  1508 FD 72 04                     LD      (IY + 4),D               ; puntero "última de la cola" del semáforo
 184  150B
 185  150B C3 A1 15                     JP      DISP                     ; cede la CPU a otra tarea (cambio de contexto)
 186  150E
 187  150E
 188  150E              ;
 189  150E              ; SOUSPROGRAMME RECHSEM     ENTREE   A=#SEMAPHORE
 190  150E              ;                           SORTIE   HL=@ SEMAPHORE
 191  150E              ;
 192  150E 07           RECHSEM         RLCA
 193  150F 07                           RLCA
 194  1510 07                           RLCA                             ; MULT. PAR 8
 195  1511                                                      ; (rotar 3 veces a la izquierda = multiplicar por 8; cada
 196  1511                                                      ; semáforo en BSEM ocupa 8 bytes)
 197  1511 5F                           LD      E,A
 198  1512 16 00                        LD      D,0
 199  1514 21 0E 10                     LD      HL,BSEM
 200  1517 19                           ADD     HL,DE                    ; HL = BSEM + (número de semáforo * 8)
 201  1518 C9                           RET
