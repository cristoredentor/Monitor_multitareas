1094  1EAE              ; TACHE 1
1095  1EAE              ;
1096  1EAE              ;
1097  1EAE 0E 41        T1              LD      C,41H
1098  1EB0 CD 9E 1E                     CALL    PRINTC
1099  1EB3 3E 01                        LD      A,1
1100  1EB5 CD C9 1B                     CALL    INIES                      ; inicializa su propio semáforo de E/S (unidad 1)
1101  1EB8
1102  1EB8 3E 01        T12             LD      A,1
1103  1EBA 01 14 00                     LD      BC,0014H                   ; arma un temporizador con cuenta 0014H (20)
1104  1EBD CD FF 1B                     CALL    ARMERH
1105  1EC0 CD 29 1C                     CALL    ACTIVH                     ; lo activa
1106  1EC3 CD 92 1B                     CALL    DEMES                      ; se bloquea esperando a que el reloj la despierte
1107  1EC6 0E 41                        LD      C,41H                      ; al despertar, vuelve a imprimir 'A'
1108  1EC8 CD 9E 1E                     CALL    PRINTC
1109  1ECB 18 EB                        JR      T12                        ; y repite para siempre
1110  1ECD
1111  1ECD
1112  1ECD              ; TACHE 2                                          -> tarea de demostración #2: imprime 'B' (42H),
1113  1ECD              ;                                                     con un período más corto (~7 ticks) que T1/T3
1114  1ECD              ;
