 305  159F              ;
 306  159F              ; DISPATCHER                              -> aquí ocurre el cambio de contexto real entre tareas
 307  159F              ;
 308  159F              ; APPELLE PAR :  PRIMITIVE P LORS D'UN BLOCAGE
 309  159F              ;                PRIMITIVE PASS SI FILE TACHES PRETES NON VIDE
 310  159F              ;
 311  159F 00 00        STOSP           .BLOCK  2                        ; GARAGE TEMPORAL SP
 312  15A1 F3           DISP            DI
 313  15A2
 314  15A2 DD 2A 0C 10                  LD      IX,(PTRTA)               ; SAUVEGARDER CTX TACHE COURS
 315  15A6 ED 73 9F 15                  LD      (STOSP),SP               ;   SEULEMENT SP
 316  15AA 2A 9F 15                     LD      HL,(STOSP)
 317  15AD DD 75 04                     LD      (IX + GARSP),L           ; guarda el SP actual dentro del campo GARSP
 318  15B0 DD 74 05                     LD      (IX + GARSP + 1),H       ; del propio contexto de la tarea que se va
 319  15B3
 320  15B3 2A 08 10     DISPP           LD      HL,(PTRDTP)              ; RESTAURER CTX 1ERE TACHE PRETE
 321  15B6 22 0C 10                     LD      (PTRTA),HL               ; la cabeza de la cola de listas pasa a ser
 322  15B9 E5                           PUSH    HL                       ; ahora "la tarea activa"
 323  15BA DD E1                        POP     IX
 324  15BC DD 36 02 02                  LD      (IX + STATUS),ACTIF
 325  15C0 DD 6E 04                     LD      L,(IX + GARSP)           ; recupera SU stack pointer guardado
 326  15C3 DD 66 05                     LD      H,(IX + GARSP + 1)
 327  15C6 F9                           LD      SP,HL                    ; RESTAURATION SP -> aquí es donde el SP pasa a
 328  15C7                                                      ; apuntar a la pila privada de la nueva tarea
 329  15C7 FD E1                        POP     IY                       ; se recuperan los registros que ESA tarea había
 330  15C9 DD E1                        POP     IX                       ; dejado guardados en su propia pila la última vez
 331  15CB C1                           POP     BC                       ; que se detuvo (por eso todas las primitivas
 332  15CC D1                           POP     DE                       ; empujan siempre los mismos 8 registros, en el
 333  15CD E1                           POP     HL                       ; mismo orden, antes de llamar a DISP)
 334  15CE F1                           POP     AF                       ; RESTAURATION REGISTRES
 335  15CF
 336  15CF FB                           EI
 337  15D0 C9                           RET
 338  15D1
