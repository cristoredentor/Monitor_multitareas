 988  18FC
 989  18FC 11 64 00                     LD      DE,TT                        ; OUI
 990  18FF FD 73 06                     LD      (IY + 6),E                   ; recarga el contador con una rebanada nueva
 991  1902 FD 72 07                     LD      (IY + 7),D
