 956  1E08 D3 C0                        OUT     (H0),A                      ; CONSTANT DE TEMPS
 957  1E0A                                                      ; programa el canal 0 del CTC: vector de interrupción, modo
 958  1E0A                                                      ; de operación y la constante de tiempo (cuenta del timer)
 959  1E0A
 960  1E0A C9                           RET
 961  1E0B
 962  1E0B
 963  1E0B              ;***************************************************************************
 964  1E0B              ;
 965  1E0B              ; ROUTINE DE TRAITEMENT D'IT DU CTC
 966  1E0B              ;
 967  1E0B              ; VERIFIER SI IL Y A DE TACHES A REVEILLER
 968  1E0B              ; CONSULTER TEMPS DE TIMER ET DEMARRER
 969  1E0B
 970  1E0B F5           RTITCTC         PUSH    AF
 971  1E0C E5                           PUSH    HL
 972  1E0D D5                           PUSH    DE
 973  1E0E C5                           PUSH    BC
 974  1E0F DD E5                        PUSH    IX
 975  1E11 FD E5                        PUSH    IY
 976  1E13
 977  1E13 DD 21 0E 10                  LD      IX,BSEM                    ; RECHERCHE SEM E/S
 978  1E17 3E 14                        LD      A,NBSEM
 979  1E19 07                           RLCA
 980  1E1A 07                           RLCA
 981  1E1B 07                           RLCA                                ; NBSEM*8 = dónde empiezan los semáforos de E/S
 982  1E1C 5F                           LD      E,A
 983  1E1D 16 00                        LD      D,0
 984  1E1F DD 19                        ADD     IX,DE
 985  1E21 DD E5                        PUSH    IX
 986  1E23 FD E1                        POP     IY                          ; IY POINTE SEM E/S 0 (la reservada al
 987  1E25                                                      ; time-slicing, ver TACHFON)
 988  1E25
 989  1E25 1E 08                        LD      E,8
 990  1E27 16 00                        LD      D,0
 991  1E29 DD 19                        ADD     IX,DE
 992  1E2B 21 36 19                     LD      HL,INREVM
 993  1E2E 23                           INC     HL
 994  1E2F 06 07                        LD      B,NBES - 1
 995  1E31 0E 01                        LD      C,1                          ; IX POINTE SEM E/S 1
 996  1E33                                                                     ; HL POINTE IND. DE REVEIL
 997  1E33                                                      ; recorre las unidades de E/S 1..NBES-1 (la 0 se trata aparte
 998  1E33                                                      ; más abajo, sólo para time-slicing)
 999  1E33
1000  1E33 DD 7E 05     REVISAR         LD      A,(IX + 5)                   ; EN ATTENTE DE REVEIL ?
1001  1E36 FE 00                        CP      FALSE
1002  1E38 28 1B                        JR      Z,SUSEMES                    ; si su watchdog no está activo, sigue con la
1003  1E3A                                                      ; siguiente unidad
1004  1E3A
1005  1E3A DD 5E 06                     LD      E,(IX + 6)                   ; OUI
1006  1E3D DD 56 07                     LD      D,(IX + 7)
1007  1E40 1B                           DEC     DE                           ; decrementa su cuenta regresiva de 16 bits
1008  1E41 DD 73 06                     LD      (IX + 6),E
1009  1E44 DD 72 07                     LD      (IX + 7),D                   ; T.D. ?
1010  1E47 7B                           LD      A,E
1011  1E48 B2                           OR      D
1012  1E49 20 0A                        JR      NZ,SUSEMES                   ; ¿llegó a 0?
1013  1E4B
1014  1E4B 79                           LD      A,C                          ; OUI
1015  1E4C CD 98 1B                     CALL    FINES                        ; REVEIL -> "se acabó el tiempo" de esta unidad:
1016  1E4F 36 01                        LD      (HL),TRUE                    ; REVEILLE PAR L'HORLOGE   despierta a quien la
1017  1E51 DD 36 05 00                  LD      (IX + 5),FALSE               ; esperaba y apaga su watchdog
1018  1E55
1019  1E55 23           SUSEMES         INC     HL                           ; CONTINUER A VERIFIER T.D.
1020  1E56 1E 08                        LD      E,8
1021  1E58 16 00                        LD      D,0
1022  1E5A DD 19                        ADD     IX,DE
1023  1E5C 0C                           INC     C
1024  1E5D 10 D4                        DJNZ    REVISAR
1025  1E5F
1026  1E5F FD 7E 05                     LD      A,(IY + 5)                   ; TIME SLICING ?
1027  1E62 FE 01                        CP      TRUE
1028  1E64 20 1C                        JR      NZ,FINITH                    ; si el time-slicing no está activo, no hay
1029  1E66                                                      ; nada más que hacer: regresar normal de la interrupción
1030  1E66
1031  1E66 FD 5E 06                     LD      E,(IY + 6)                   ; OUI
1032  1E69 FD 56 07                     LD      D,(IY + 7)
1033  1E6C 1B                           DEC     DE                           ; decrementa el contador de la rebanada de tiempo
1034  1E6D FD 73 06                     LD      (IY + 6),E
1035  1E70 FD 72 07                     LD      (IY + 7),D                   ; FIN TRANCHE ?
1036  1E73 7B                           LD      A,E
1037  1E74 B2                           OR      D
1038  1E75 20 0B                        JR      NZ,FINITH                    ; ¿se acabó la rebanada?
1039  1E77
1040  1E77 11 64 00                     LD      DE,TT                        ; OUI
1041  1E7A FD 73 06                     LD      (IY + 6),E                   ; recarga el contador con una rebanada nueva
1042  1E7D FD 72 07                     LD      (IY + 7),D
1043  1E80 18 0B                        JR      TEMPART                      ; y fuerza un cambio de tarea (preemption)
1044  1E82
1045  1E82 FD E1        FINITH          POP     IY                           ; caso normal: no hay que forzar cambio de
1046  1E84 DD E1                        POP     IX                           ; tarea, sólo restaurar registros y volver
1047  1E86 C1                           POP     BC
1048  1E87 D1                           POP     DE
1049  1E88 E1                           POP     HL
1050  1E89 F1                           POP     AF
1051  1E8A
1052  1E8A FB                           EI
1053  1E8B ED 4D                        RETI
1054  1E8D
1055  1E8D 21 93 1E     TEMPART         LD      HL,TIMSLIC                   ; FAIRE PASS
1056  1E90 E5                           PUSH    HL                           ; "engaña" al RETI empujando la dirección de
1057  1E91 ED 4D                        RETI                                 ; TIMSLIC, para saltar ahí después de retornar
1058  1E93
1059  1E93 FD E1        TIMSLIC         POP     IY                           ; se restauran los registros normalmente...
1060  1E95 DD E1                        POP     IX
1061  1E97 C1                           POP     BC
1062  1E98 D1                           POP     DE
1063  1E99 E1                           POP     HL
1064  1E9A F1                           POP     AF
1065  1E9B
1066  1E9B C3 4C 1B                     JP      PASS                         ; ...y se fuerza un PASS: cambio de tarea
1067  1E9E                                                      ; preventivo (esto es lo que hace real el time-slicing)
1068  1E9E
1069  1E9E
1070  1E9E              ;***************************************************************************
1071  1E9E              ;
1072  1E9E              ; PRINTC                                   RUTINA DE CONSOLA SIMULADA
1073  1E9E              ;                                           ENTREE  C = caracter a "imprimir"
1074  1E9E              ;                                           No destruye ningún registro (salvo flags).
1075  1E9E              ;
1076  1E9E F5           PRINTC          PUSH    AF
1077  1E9F E5                           PUSH    HL
1078  1EA0
1079  1EA0 79                           LD      A,C
1080  1EA1 D3 FF                        OUT     (CONSOLE_PORT),A          ; salida por puerto, para emuladores que lo simulen
1081  1EA3
1082  1EA3 2A 27 1A                     LD      HL,(CONSPTR)
1083  1EA6 77                           LD      (HL),A                    ; y además se guarda en CONSBUF, en orden
1084  1EA7 23                           INC     HL
1085  1EA8 22 27 1A                     LD      (CONSPTR),HL
1086  1EAB
1087  1EAB E1                           POP     HL
1088  1EAC F1                           POP     AF
1089  1EAD C9                           RET
1090  1EAE
