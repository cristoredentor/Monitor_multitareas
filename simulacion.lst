   1  0000              ; MONITEUR
   2  0000              ;
   3  0000
   4  0000              ; DONNEES FICTIVES
   5  0000
   6  0000              NIL             .EQU    00H
   7  0000                                                      ; valor "nulo" para punteros de 16 bits (fin de una lista)
   8  0000              FALSE            .EQU    00H             ;Ante falta de boolean ponemos un falso = 0
   9  0000              TRUE            .EQU    01H              ;True = 1
  10  0000
  11  0000
  12  0000              NONCREE         .EQU    00H           ; bloque de contexto libre: no representa ninguna tarea
  13  0000              PRET            .EQU    01H           ; tarea creada, lista para ejecutar, esperando su turno
  14  0000              ACTIF           .EQU    02H           ; la única tarea que tiene la CPU en este momento
  15  0000              BLOQUEO          .EQU    03H          ; tarea esperando un semáforo (P) o una E/S (DEMES)
  16  0000
  17  0000                                                      ; CONSTANTES DES CTX
  18  0000                                                      ; LG INFO CTX
  19  0000              LONGCTX         .EQU    6             ; tamaño en bytes del "header"/metadatos de una tarea
  20  0000              LONGPIL         .EQU    100           ; tamaño en bytes de la pila privada de cada tarea
  21  0000                                                      ; [FIX] Antes era 30. Cuando el reloj interrumpe justo
  22  0000                                                      ; mientras una tarea está corriendo, la rutina de interrupción
  23  0000                                                      ; (RTITCTC) usa la pila PROPIA de esa tarea (los procesadores
  24  0000                                                      ; Z80 no cambian de pila al entrar a una IT); si de paso
  25  0000                                                      ; expiró un watchdog, RTITCTC anida CALL FINES -> V() ->
  26  0000                                                      ; SIGNAL, cada uno con sus propios PUSH/CALL. Sumando la
  27  0000                                                      ; dirección de retorno de la IT, los 6 registros que guarda
  28  0000                                                      ; RTITCTC, y los PUSH/CALL de FINES y V(), esa cadena anidada
  29  0000                                                      ; necesita más de 30 bytes; con 30 la pila se desbordaba hacia
  30  0000                                                      ; atrás y pisaba el encabezado (CHTPMS/STATUS/SEMAT/GARSP) del
  31  0000                                                      ; propio bloque de contexto de la tarea, corrompiendo el
  32  0000                                                      ; scheduler (así terminaba una tarea con SP apuntando a
  33  0000                                                      ; 0000H/basura tras ser despertada). Se probó con el emulador:
  34  0000                                                      ; con 64 seguía fallando más adelante; con 100 corrió más de
  35  0000                                                      ; 60 millones de instrucciones sin corromperse.
  36  0000              LONGDCTX        .EQU    LONGPIL + LONGCTX ; tamaño TOTAL de un bloque de tarea = header + su pila
  37  0000                                                      ; LG PILE
  38  0000                                                      ; LG CTX
  39  0000                                                      ; CHAMPS DES CTX
  40  0000              CHTPMS          .EQU    0               ; CHAINE PRETES OU A SEMAPHORE
  41  0000                                                      ; puntero (2 bytes) a la SIGUIENTE tarea en la lista donde
  42  0000                                                      ; esté encadenada esta (cola de listas o cola de un semáforo)
  43  0000              STATUS          .EQU    2               ; ETAT DE LA TACHE
  44  0000                                                      ; 1 byte con uno de los 4 estados: NONCREE/PRET/ACTIF/BLOQUEO
  45  0000              SEMAT           .EQU    3               ; SEMAPHORE BLOQUANT
  46  0000                                                      ; número de semáforo donde quedó bloqueada
  47  0000              GARSP           .EQU    4               ; GARAGE SP
  48  0000                                                      ; aquí se guarda el SP (2 bytes) de la tarea cuando NO está
  49  0000                                                      ; corriendo, para poder restaurarlo en el cambio de contexto
  50  0000                                                      ; CONSTANTES DU MONITEUR
  51  0000              NBMCTX          .EQU    20              ; NB MAX CTX
  52  0000                                                      ; máximo de tareas simultáneas
  53  0000              NBSEM           .EQU    20              ; NB MAX SEMAPHORES
  54  0000                                                      ; máximo de semáforos "normales" (los que usan P/V)
  55  0000              NBES            .EQU    8               ; NB MAX E/S
  56  0000                                                      ; máximo de unidades de E/S simuladas (con watchdog)
  57  0000              SEMPES          .EQU    NBSEM + NBES
  58  0000                                                      ; total de entradas de la tabla BSEM: primero los NBSEM
  59  0000                                                      ; semáforos normales y luego los NBES semáforos de E/S
  60  0000
  61  0000                                                      ; 3 PERIPHERIQUES
  62  0000              H0              .EQU    7C0H            ; TIMER 0 CTC
  63  0000                                                      ; puerto de E/S del canal 0 del CTC (Counter/Timer Circuit):
  64  0000                                                      ; genera la interrupción periódica de reloj
  65  0000              TT              .EQU    0064H           ; CONSTANT T.D.
  66  0000                                                      ; cuántos "ticks" de reloj dura una rebanada de tiempo
  67  0000                                                      ; (time slice) para el reparto de CPU por time-slicing
  68  0000                                                      ; TRANCHE = TT A 25 MS
  69  0000
  70  0000                              .ORG    1000H - 3
  71  0FFD                                                      ; el código "real" empieza en 1000H; se dejan 3 bytes antes
  72  0FFD                                                      ; para un pequeño encabezado (las dos .WORD de abajo)
  73  0FFD EE 10                        .WORD   INICTX
  74  0FFF                                                      ; palabra de cabecera: dirección de la zona de contextos
  75  0FFF 0C 1F                        .WORD   FINAL
  76  1001                                                      ; palabra de cabecera: dirección de fin del programa
  77  1001              NBIOIO          .EQU    $
  78  1001                                                      ; aquí arranca el código ejecutable, en la dirección 1000H
  79  1001 C3 86 1D                     JP      DEBMON
  80  1004                                                      ; primera instrucción real: saltar a inicializar el monitor
  81  1004
  82  1004              ; DONNEES UTILES
  83  1004
  84  1004                                                      ; TABLE CENTRALE
  85  1004 00 00        PTRCTXL         .BLOCK  2               ; POINTEUR CTX LIBRE CREATION
  86  1006                                                      ; dirección del próximo bloque de memoria libre donde CREER
  87  1006                                                      ; puede crear una tarea nueva
  88  1006 00 00        NBCTX           .BLOCK  2               ; NB CTX CREES
  89  1008                                                      ; cuántas tareas existen (creadas) hasta este momento
  90  1008 00 00        PTRDTP          .BLOCK  2               ; PTR CTX DEBUT TACHES PRETES
  91  100A                                                      ; cabeza de la cola de tareas listas (la próxima en correr)
  92  100A 00 00        PTRFTP          .BLOCK  2               ;       FIN
  93  100C                                                      ; cola (el final) de la cola de tareas listas
  94  100C 00 00        PTRTA           .BLOCK  2               ; PTR CTX TACHE EN COURS
  95  100E                                                      ; puntero a la tarea que se está ejecutando ahora mismo
  96  100E                                                      ; ZONE MEMOIRE SEMAPHORES
  97  100E 00 00 00...  BSEM            .BLOCK  8*SEMPES
  98  10EE                                                      ; tabla de TODOS los semáforos, 8 bytes cada uno:
  99  10EE                                                      ; +0 contador (OPTEUR), +1/+2 cabeza cola de espera,
 100  10EE                                                      ; +3/+4 cola (fin) de la cola de espera; solo para los de
 101  10EE                                                      ; E/S además: +5 watchdog activo (V/F), +6/+7 cuenta regresiva
 102  10EE
 103  10EE                                                      ; ZONE MEMOIRE CTX
 104  10EE                                                      ; cada bloque de tarea mide LONGDCTX bytes: header (LONGCTX)
 105  10EE                                                      ; + su pila privada (LONGPIL)
 106  10EE 00 00 00...  INICTX          .BLOCK  LONGDCTX*NBMCTX
 107  1936
 108  1936 00 00 00...  INREVM          .BLOCK  NBES            ; INDICATEURS REVEIL (V/F)
 109  193E                                                      ; un byte por unidad de E/S: ¿esta tarea fue despertada por
 110  193E                                                      ; el reloj (watchdog) o por un FINES manual?
 111  193E
 112  193E 00 00 00...  PILSYS          .BLOCK  30              ; PILE SYSTEME
 113  195C                                                      ; pila usada solo durante el arranque (DEBMON), antes de que
 114  195C                                                      ; exista ninguna tarea todavía
 115  195C 00           PPILSYS         .BLOCK  1
 116  195D                                                      ; tope inicial de PILSYS (la pila crece hacia direcciones
 117  195D                                                      ; menores, por eso el SP arranca aquí, al final del bloque)
 118  195D
