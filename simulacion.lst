 136  1A29              ; PRIMITIVE P(#SEMAPHORE)
 137  1A29                                                      ; se usa el nombre "SEMP" en vez de "P": "P" es la condición
 138  1A29                                                      ; de signo positivo del Z80 y choca con instrucciones como
 139  1A29                                                      ; "JP P,..." (ver su uso en DEMES, más abajo)
 140  1A29 F3           SEMP            DI
 141  1A2A
 142  1A2A
 143  1A2A F5                           PUSH    AF                       ; se guardan los registros que esta rutina toca,
 144  1A2B E5                           PUSH    HL                       ; para poder restaurarlos intactos si al final
 145  1A2C D5                           PUSH    DE                       ; resulta que NO hubo que bloquear la tarea
 146  1A2D C5                           PUSH    BC
 147  1A2E
 148  1A2E 47                           LD      B,A                      ; guarda el número de semáforo en B, porque
 149  1A2F                                                      ; RECHSEM va a destruir el valor de A
 150  1A2F
 151  1A2F CD 89 1A                     CALL    RECHSEM                  ; HL POINTE SEMAPHORE
 152  1A32 35                           DEC (HL)
 153  1A33 FA 3C 1A                     JP      M,WAIT                   ; SI OPTEUR < 0 ALORS WAIT
 154  1A36                                                               ; si el contador quedó negativo, no había recurso libre:
 155  1A36                                                               ; bloquear la tarea actual (saltar a WAIT)
 156  1A36
 157  1A36 C1                           POP     BC                       ; NON BLOQUEE, CONTINUER
 158  1A37 D1                           POP     DE                       ; sí había recurso disponible: se restauran los
 159  1A38 E1                           POP     HL                       ; registros tal cual estaban y se sigue de largo,
 160  1A39 F1                           POP     AF                       ; sin cambiar de tarea
 161  1A3A
 162  1A3A FB                           EI
 163  1A3B C9                           RET
 164  1A3C
 165  1A3C DD E5        WAIT            PUSH    IX                       ; BLOCAGE TACHE EXECUTANT P
 166  1A3E FD E5                        PUSH    IY
 167  1A40
 168  1A40 EB                           EX      DE,HL                    ; ahora DE apunta al semáforo (antes en HL)
 169  1A41 D5                           PUSH    DE
 170  1A42 FD E1                        POP     IY                       ; DE,IY POINTENT SEMAPHORE
 171  1A44
 172  1A44 DD 2A 0C 10                  LD      IX,(PTRTA)               ; IX POINTE CTX TACHE EN COURS
 173  1A48
 174  1A48 DD E5                        PUSH    IX
 175  1A4A D1                           POP     DE                       ; [FIX] DE = dirección de la tarea que se bloquea.
 176  1A4B                                                      ; Antes DE seguía valiendo lo que dejó "EX DE,HL" más arriba
 177  1A4B                                                      ; (la dirección del PROPIO SEMÁFORO), así que las líneas de
 178  1A4B                                                      ; abajo que encadenan la tarea en la cola de espera del
 179  1A4B                                                      ; semáforo ((IY+1)/(IY+2), (IX+CHTPMS) de NOVIDER, (IY+3)/
 180  1A4B                                                      ; (IY+4)) terminaban enlazando la dirección del semáforo
 181  1A4B                                                      ; consigo mismo en vez de apuntar a esta tarea. Cuando V()/
 182  1A4B                                                      ; SIGNAL luego intenta despertarla, lee ese "puntero" y trata
 183  1A4B                                                      ; los bytes del semáforo como si fueran un bloque de tarea,
 184  1A4B                                                      ; corrompiendo memoria (así es como T2 terminaba saltando a
 185  1A4B                                                      ; SP=000CH tras ser "despertada").
 186  1A4B
 187  1A4B DD 6E 00                     LD      L,(IX + CHTPMS)          ; EXTRAIRE TETE TACHES PRETES
 188  1A4E DD 66 01                     LD      H,(IX + CHTPMS + 1)      ; toma quién era "el siguiente" de la tarea actual
 189  1A51 22 08 10                     LD      (PTRDTP),HL              ; y lo hace la nueva cabeza de la cola de listas
 190  1A54
 191  1A54 DD 36 00 00                  LD      (IX + CHTPMS),NIL        ; AJOUTER A TETE ATTENTE SEM
 192  1A58 DD 36 01 00                  LD      (IX + CHTPMS + 1),NIL    ; (se limpia el puntero de encadenamiento; se fija
 193  1A5C DD 36 02 03                  LD      (IX + STATUS),BLOQUEO    ; según si la cola del semáforo está vacía o no,
 194  1A60 DD 70 03                     LD      (IX + SEMAT),B           ; más abajo). Guarda en qué semáforo quedó (B).
 195  1A63
 196  1A63 FD 7E 01                     LD      A,(IY + 1)               ; (IY+1) = byte bajo de la cabeza de la cola espera
 197  1A66 A7                           AND     A                        ; A = A-T-IL FALLU BLOQUER ? (en realidad prueba si
 198  1A67 20 08                        JR      NZ,NOVIDER               ; la cola de espera del semáforo ya tenía tareas)
 199  1A69
 200  1A69 FD 73 01                     LD      (IY + 1),E               ; FILE VIDE -> la cola estaba vacía: esta tarea
 201  1A6C FD 72 02                     LD      (IY + 2),D               ; PTR DEBUT FILE   pasa a ser cabeza Y cola a la vez
 202  1A6F 18 0F                        JR      CONTW
 203  1A71 FD 6E 03     NOVIDER         LD      L,(IY + 3)               ; la cola no estaba vacía: toma la última tarea que
 204  1A74 FD 66 04                     LD      H,(IY + 4)               ; ya esperaba en este semáforo...
 205  1A77 E5                           PUSH    HL
 206  1A78 DD E1                        POP     IX
 207  1A7A DD 73 00                     LD      (IX + CHTPMS),E
 208  1A7D DD 72 01                     LD      (IX + CHTPMS + 1),D      ; CHAINAGE  (...y hace que esa última apunte ahora
 209  1A80                                                      ; a la tarea que se acaba de bloquear)
 210  1A80 FD 73 03     CONTW           LD      (IY + 3),E               ; PTR FIN FILE -> en ambos casos, actualiza el
 211  1A83 FD 72 04                     LD      (IY + 4),D               ; puntero "última de la cola" del semáforo
 212  1A86
 213  1A86 C3 1C 1B                     JP      DISP                     ; cede la CPU a otra tarea (cambio de contexto)
 214  1A89
