 332  1B1A              ;***************************************************************************
 333  1B1A              ;
 334  1B1A              ; DISPATCHER                              -> aquí ocurre el cambio de contexto real entre tareas
 335  1B1A              ;
 336  1B1A              ; APPELLE PAR :  PRIMITIVE P LORS D'UN BLOCAGE
 337  1B1A              ;                PRIMITIVE PASS SI FILE TACHES PRETES NON VIDE
 338  1B1A              ;
 339  1B1A 00 00        STOSP           .BLOCK  2                        ; GARAGE TEMPORAL SP
 340  1B1C F3           DISP            DI
 341  1B1D
 342  1B1D DD 2A 0C 10                  LD      IX,(PTRTA)               ; SAUVEGARDER CTX TACHE COURS
 343  1B21 ED 73 1A 1B                  LD      (STOSP),SP               ;   SEULEMENT SP
 344  1B25 2A 1A 1B                     LD      HL,(STOSP)
 345  1B28 DD 75 04                     LD      (IX + GARSP),L           ; guarda el SP actual dentro del campo GARSP
 346  1B2B DD 74 05                     LD      (IX + GARSP + 1),H       ; del propio contexto de la tarea que se va
 347  1B2E
 348  1B2E 2A 08 10     DISPP           LD      HL,(PTRDTP)              ; RESTAURER CTX 1ERE TACHE PRETE
 349  1B31 22 0C 10                     LD      (PTRTA),HL               ; la cabeza de la cola de listas pasa a ser
 350  1B34 E5                           PUSH    HL                       ; ahora "la tarea activa"
 351  1B35 DD E1                        POP     IX
 352  1B37 DD 36 02 02                  LD      (IX + STATUS),ACTIF
 353  1B3B DD 6E 04                     LD      L,(IX + GARSP)           ; recupera SU stack pointer guardado
 354  1B3E DD 66 05                     LD      H,(IX + GARSP + 1)
 355  1B41 F9                           LD      SP,HL                    ; RESTAURATION SP -> aquí es donde el SP pasa a
 356  1B42                                                      ; apuntar a la pila privada de la nueva tarea
 357  1B42 FD E1                        POP     IY                       ; se recuperan los registros que ESA tarea había
 358  1B44 DD E1                        POP     IX                       ; dejado guardados en su propia pila la última vez
 359  1B46 C1                           POP     BC                       ; que se detuvo (por eso todas las primitivas
 360  1B47 D1                           POP     DE                       ; empujan siempre los mismos 8 registros, en el
 361  1B48 E1                           POP     HL                       ; mismo orden, antes de llamar a DISP)
 362  1B49 F1                           POP     AF                       ; RESTAURATION REGISTRES
 363  1B4A
 364  1B4A FB                           EI
 365  1B4B C9                           RET
