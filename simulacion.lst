   3  0000
   4  0000              ; DONNEES FICTIVES
   5  0000
   6  0000              NIL             .EQU    00H
   7  0000                                                      ; valor "nulo" para punteros de 16 bits (fin de una lista)
   8  0000              FALSE            .EQU    00H             ;Ante falta de boolean ponemos un falso = 0
   9  0000              TRUE            .EQU    01H              ;True = 1
  10  0000
  11  0000
  12  0000              NONCREE         .EQU    00H           ; bloque de contexto libre: no representa ninguna tarea
  13  0000              PRET            .EQU    01H           ; tarea creada, lista para ejecutar, esperando su turno
  14  0000              ACTIF           .EQU    02H           ; la única tarea que tiene la CPU en este momento
  15  0000              BLOQUEO          .EQU    03H          ; tarea esperando un semáforo (P) o una E/S (DEMES)
  16  0000
  17  0000                                                      ; CONSTANTES DES CTX
  18  0000                                                      ; LG INFO CTX
  19  0000              LONGCTX         .EQU    6             ; tamaño en bytes del "header"/metadatos de una tarea
  20  0000              LONGPIL         .EQU    30            ; tamaño en bytes de la pila privada de cada tarea
  21  0000              LONGDCTX        .EQU    LONGPIL + LONGCTX ; tamaño TOTAL de un bloque de tarea = header + su pila
  22  0000                                                      ; LG PILE
  23  0000                                                      ; LG CTX
  24  0000                                                      ; CHAMPS DES CTX
  25  0000              CHTPMS          .EQU    0               ; CHAINE PRETES OU A SEMAPHORE
  26  0000                                                      ; puntero (2 bytes) a la SIGUIENTE tarea en la lista donde
  27  0000                                                      ; esté encadenada esta (cola de listas o cola de un semáforo)
  28  0000              STATUS          .EQU    2               ; ETAT DE LA TACHE
  29  0000                                                      ; 1 byte con uno de los 4 estados: NONCREE/PRET/ACTIF/BLOQUEO
  30  0000              SEMAT           .EQU    3               ; SEMAPHORE BLOQUANT
  31  0000                                                      ; número de semáforo donde quedó bloqueada
  32  0000              GARSP           .EQU    4               ; GARAGE SP
  33  0000                                                      ; aquí se guarda el SP (2 bytes) de la tarea cuando NO está
  34  0000                                                      ; corriendo, para poder restaurarlo en el cambio de contexto
  35  0000                                                      ; CONSTANTES DU MONITEUR
  36  0000              NBMCTX          .EQU    20              ; NB MAX CTX
  37  0000                                                      ; máximo de tareas simultáneas
  38  0000              NBSEM           .EQU    20              ; NB MAX SEMAPHORES
  39  0000                                                      ; máximo de semáforos "normales" (los que usan P/V)
  40  0000              NBES            .EQU    8               ; NB MAX E/S
  41  0000                                                      ; máximo de unidades de E/S simuladas (con watchdog)
  42  0000              SEMPES          .EQU    NBSEM + NBES
  43  0000                                                      ; total de entradas de la tabla BSEM: primero los NBSEM
  44  0000                                                      ; semáforos normales y luego los NBES semáforos de E/S
  45  0000
  46  0000                                                      ; 3 PERIPHERIQUES
  47  0000              H0              .EQU    7C0H            ; TIMER 0 CTC
  48  0000                                                      ; puerto de E/S del canal 0 del CTC (Counter/Timer Circuit):
  49  0000                                                      ; genera la interrupción periódica de reloj
  50  0000              TT              .EQU    0064H           ; CONSTANT T.D.
  51  0000                                                      ; cuántos "ticks" de reloj dura una rebanada de tiempo
  52  0000                                                      ; (time slice) para el reparto de CPU por time-slicing
  53  0000                                                      ; TRANCHE = TT A 25 MS
  54  0000
  55  0000                              .ORG    1000H - 3
  56  0FFD                                                      ; el código "real" empieza en 1000H; se dejan 3 bytes antes
  57  0FFD                                                      ; para un pequeño encabezado (las dos .WORD de abajo)
  58  0FFD EE 10                        .WORD   INICTX
  59  0FFF                                                      ; palabra de cabecera: dirección de la zona de contextos
  60  0FFF 91 19                        .WORD   FINAL
  61  1001                                                      ; palabra de cabecera: dirección de fin del programa
  62  1001              NBIOIO          .EQU    $
  63  1001                                                      ; aquí arranca el código ejecutable, en la dirección 1000H
  64  1001 C3 0B 18                     JP      DEBMON
  65  1004                                                      ; primera instrucción real: saltar a inicializar el monitor
  66  1004
  67  1004              ; DONNEES UTILES
  68  1004
  69  1004                                                      ; TABLE CENTRALE
  70  1004 00 00        PTRCTXL         .BLOCK  2               ; POINTEUR CTX LIBRE CREATION
  71  1006                                                      ; dirección del próximo bloque de memoria libre donde CREER
  72  1006                                                      ; puede crear una tarea nueva
  73  1006 00 00        NBCTX           .BLOCK  2               ; NB CTX CREES
  74  1008                                                      ; cuántas tareas existen (creadas) hasta este momento
  75  1008 00 00        PTRDTP          .BLOCK  2               ; PTR CTX DEBUT TACHES PRETES
  76  100A                                                      ; cabeza de la cola de tareas listas (la próxima en correr)
  77  100A 00 00        PTRFTP          .BLOCK  2               ;       FIN
  78  100C                                                      ; cola (el final) de la cola de tareas listas
  79  100C 00 00        PTRTA           .BLOCK  2               ; PTR CTX TACHE EN COURS
  80  100E                                                      ; puntero a la tarea que se está ejecutando ahora mismo
  81  100E                                                      ; ZONE MEMOIRE SEMAPHORES
  82  100E 00 00 00...  BSEM            .BLOCK  8*SEMPES
  83  10EE                                                      ; tabla de TODOS los semáforos, 8 bytes cada uno:
  84  10EE                                                      ; +0 contador (OPTEUR), +1/+2 cabeza cola de espera,
  85  10EE                                                      ; +3/+4 cola (fin) de la cola de espera; solo para los de
  86  10EE                                                      ; E/S además: +5 watchdog activo (V/F), +6/+7 cuenta regresiva
  87  10EE
  88  10EE                                                      ; ZONE MEMOIRE CTX
  89  10EE                                                      ; cada bloque de tarea mide LONGDCTX bytes: header (LONGCTX)
  90  10EE                                                      ; + su pila privada (LONGPIL)
  91  10EE 00 00 00...  INICTX          .BLOCK  LONGDCTX*NBMCTX
  92  13BE
  93  13BE 00 00 00...  INREVM          .BLOCK  NBES            ; INDICATEURS REVEIL (V/F)
  94  13C6                                                      ; un byte por unidad de E/S: ¿esta tarea fue despertada por
  95  13C6                                                      ; el reloj (watchdog) o por un FINES manual?
  96  13C6
  97  13C6 00 00 00...  PILSYS          .BLOCK  30              ; PILE SYSTEME
  98  13E4                                                      ; pila usada solo durante el arranque (DEBMON), antes de que
  99  13E4                                                      ; exista ninguna tarea todavía
 100  13E4 00           PPILSYS         .BLOCK  1
 101  13E5                                                      ; tope inicial de PILSYS (la pila crece hacia direcciones
 102  13E5                                                      ; menores, por eso el SP arranca aquí, al final del bloque)
 103  13E5
