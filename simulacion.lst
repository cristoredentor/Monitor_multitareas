 625  16FC 73                           LD      (HL),E                   ; @ DEBUT AU FOND PILE
 626  16FD                                                      ; escribe la dirección de inicio del programa (@DEBUT) al
 627  16FD                                                      ; fondo de la pila de la nueva tarea, para que el DISPATCHER
 628  16FD                                                      ; "salte" ahí (con su POP+RET/POP AF final) la primera vez
 629  16FD 06 06                        LD      B,6                      ; INITIALISATION REGISTRES A 0
 630  16FF 2B           INIREG          DEC     HL
