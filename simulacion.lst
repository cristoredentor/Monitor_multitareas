1116  1ECF CD 9E 1E                     CALL    PRINTC
1117  1ED2 3E 02                        LD      A,2
1118  1ED4 CD C9 1B                     CALL    INIES                      ; semáforo de E/S de la unidad 2
1119  1ED7 3E 02        T21             LD      A,2
1120  1ED9 01 07 00                     LD      BC,0007H                   ; cuenta más chica: se despierta más seguido
1121  1EDC CD FF 1B                     CALL    ARMERH
1122  1EDF CD 29 1C                     CALL    ACTIVH
1123  1EE2 CD 92 1B                     CALL    DEMES
1124  1EE5 0E 42                        LD      C,42H
1125  1EE7 CD 9E 1E                     CALL    PRINTC
1126  1EEA 18 EB                        JR      T21
1127  1EEC
1128  1EEC
1129  1EEC              ; TACHE 3                                          -> tarea de demostración #3: imprime 'C' (43H),
1130  1EEC              ;                                                     mismo período que T1 (~20 ticks)
1131  1EEC              ;
1132  1EEC 2E 43        T3              LD      L,43H
1133  1EEE 4D                           LD      C,L
1134  1EEF CD 9E 1E                     CALL    PRINTC
1135  1EF2 3E 03                        LD      A,3
1136  1EF4 CD C9 1B                     CALL    INIES                      ; semáforo de E/S de la unidad 3
1137  1EF7 3E 03        T31             LD      A,3
1138  1EF9 01 14 00                     LD      BC,0014H
