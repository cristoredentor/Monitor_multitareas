 233  1A94              ;
 234  1A94              ; PRIMITIVE V(#SEMAPHORE)                  -> operación V (signal) de Dijkstra
 235  1A94              ;
 236  1A94 F3           V               DI
 237  1A95
 238  1A95 F5                           PUSH    AF
 239  1A96 E5                           PUSH    HL
 240  1A97 D5                           PUSH    DE
 241  1A98
 242  1A98 CD 89 1A                     CALL    RECHSEM                  ; HL POINTE SEMAPHORE
 243  1A9B
 244  1A9B 34                           INC     (HL)
 245  1A9C                                                        ; OPTEUR = OPTEUR + 1
 246  1A9C
 247  1A9C FA A5 1A                     JP      M,SIGNAL
 248  1A9F CA A5 1A                     JP      Z,SIGNAL                 ; DEBLOCAGE D'UNE TACHE
 249  1AA2                                                      ; si tras incrementar quedó negativo o -1 manda signal
 250  1AA2
 251  1AA2 C3 ED 1A                     JP      FINV                     ; CONTINUER
 252  1AA5
 253  1AA5
 254  1AA5 E5           SIGNAL          PUSH    HL
 255  1AA6 FD E1                        POP     IY                       ; IY POINTE SEMAPHORE
 256  1AA8
 257  1AA8 FD 5E 01                     LD      E,(IY + 1)
 258  1AAB FD 56 02                     LD      D,(IY + 2)               ; EXTRAIRE 1 CTX FILE SEM
 259  1AAE D5                           PUSH    DE
 260  1AAF DD E1                        POP     IX                       ; DE,IX POINTENT TACHE DEBLOQ
 261  1AB1                                                      ; IX/DE = la tarea que estaba en la CABEZA de la cola de
 262  1AB1                                                      ; espera del semáforo: es la que se va a desbloquear
 263  1AB1
 264  1AB1 7E                           LD      A,(HL)
 265  1AB2 B7                           OR      A
 266  1AB3 20 12                        JR      NZ,NOVIDEV
 267  1AB5 FD 36 01 00                  LD      (IY + 1),NIL
 268  1AB9 FD 36 02 00                  LD      (IY + 2),NIL
 269  1ABD FD 36 03 00                  LD      (IY + 3),NIL
 270  1AC1 FD 36 04 00                  LD      (IY + 4),NIL             ; LA FILE EST VIDE
 271  1AC5                                                      ; el contador quedó en 0: no queda nadie más esperando,
 272  1AC5                                                      ; se limpian todos los punteros de la cola de espera
 273  1AC5 18 0C                        JR      CONTV
 274  1AC7 DD 6E 00     NOVIDEV         LD      L,(IX + CHTPMS)
 275  1ACA DD 66 01                     LD      H,(IX + CHTPMS + 1)      ; LA FILE N'EST PAS VIDE
 276  1ACD FD 75 01                     LD      (IY + 1),L
 277  1AD0 FD 74 02                     LD      (IY + 2),H               ; CHAINAGE FILE
 278  1AD3                                                      ; todavía queda alguien esperando: avanza la cabeza de la
 279  1AD3                                                      ; cola de espera al que era "siguiente" de la tarea desbloq.
 280  1AD3
 281  1AD3 DD 36 00 00  CONTV           LD      (IX + CHTPMS),NIL        ; AJOUTER A FILE TACHES PRETES
 282  1AD7 DD 36 01 00                  LD      (IX + CHTPMS + 1),NIL
 283  1ADB DD 36 02 01                  LD      (IX + STATUS),PRET
 284  1ADF                                                      ; la tarea desbloqueada se agrega al FINAL de la cola de
 285  1ADF                                                      ; tareas listas (vuelve a competir por CPU normalmente)
 286  1ADF
 287  1ADF DD 2A 0A 10                  LD      IX,(PTRFTP)              ; IX POINTE DERNIERE PRETE
 288  1AE3 DD 73 00                     LD      (IX + CHTPMS),E
 289  1AE6 DD 72 01                     LD      (IX + CHTPMS + 1),D
 290  1AE9 ED 53 0A 10                  LD      (PTRFTP),DE
 291  1AED
 292  1AED D1           FINV            POP     DE
 293  1AEE E1                           POP     HL
 294  1AEF F1                           POP     AF
