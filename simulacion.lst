 506  1BCD DD E5                        PUSH    IX
 507  1BCF
 508  1BCF 5F                           LD      E,A
 509  1BD0 16 00                        LD      D,0
 510  1BD2 21 36 19                     LD      HL,INREVM
 511  1BD5 19                           ADD     HL,DE
 512  1BD6 36 00                        LD      (HL),FALSE                ; NON REVEILLE PAR HORLOGE
 513  1BD8
 514  1BD8 C6 14                        ADD     A,NBSEM
 515  1BDA CD 89 1A                     CALL    RECHSEM
 516  1BDD E5                           PUSH    HL
 517  1BDE DD E1                        POP     IX                       ; IX POINTE SEMAPHORE
 518  1BE0
 519  1BE0 DD 36 00 00                  LD      (IX + 0),0               ; OPTEUR = 0
 520  1BE4 DD 36 01 00                  LD      (IX + 1),NIL
 521  1BE8 DD 36 02 00                  LD      (IX + 2),NIL             ; (cabeza y cola de la cola de espera = vacía)
 522  1BEC DD 36 03 00                  LD      (IX + 3),NIL
 523  1BF0 DD 36 04 00                  LD      (IX + 4),NIL
 524  1BF4 DD 36 05 00                  LD      (IX + 5),FALSE            ; INHIBITION T.D.
 525  1BF8
 526  1BF8 DD E1                        POP     IX
 527  1BFA D1                           POP     DE
 528  1BFB E1                           POP     HL
 529  1BFC F1                           POP     AF
 530  1BFD
 531  1BFD FB                           EI
 532  1BFE C9                           RET
 533  1BFF
