 613  16F2 22 04 10                     LD      (PTRCTXL),HL             ; ACTUALISATION PTRCTXL
 614  16F5
 615  16F5 2B                           DEC     HL                       ; HL POINTE FOND FILE
 616  16F6                                                      ; HL queda apuntando al ÚLTIMO byte del bloque recién
 617  16F6                                                      ; reservado (el fondo de la pila de esta tarea, ya que la
 618  16F6                                                      ; pila del Z80 crece hacia direcciones menores)
 619  16F6 EB                           EX      DE,HL
