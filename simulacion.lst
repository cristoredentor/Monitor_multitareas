 546  1C03 C5                           PUSH    BC
 547  1C04 DD E5                        PUSH    IX
 548  1C06
 549  1C06 5F                           LD      E,A
 550  1C07 16 00                        LD      D,0
 551  1C09 21 36 19                     LD      HL,INREVM
 552  1C0C 19                           ADD     HL,DE
 553  1C0D 36 00                        LD      (HL),FALSE                ; NON REVEILLE PAR HORLOGE
 554  1C0F
 555  1C0F C6 14                        ADD     A,NBSEM
 556  1C11 CD 89 1A                     CALL    RECHSEM
 557  1C14 E5                           PUSH    HL
 558  1C15 DD E1                        POP     IX
 559  1C17 DD 36 05 00                  LD      (IX + 5),FALSE
 560  1C1B DD 71 06                     LD      (IX + 6),C               ; INITIALISATION OPTEUR
 561  1C1E DD 70 07                     LD      (IX + 7),B
 562  1C21
 563  1C21 DD E1                        POP     IX
 564  1C23 C1                           POP     BC
 565  1C24 D1                           POP     DE
 566  1C25 E1                           POP     HL
 567  1C26 F1                           POP     AF
 568  1C27
 569  1C27 FB                           EI
