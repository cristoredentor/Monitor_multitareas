 926  1898 DD 21 0E 10                  LD      IX,BSEM                    ; RECHERCHE SEM E/S
 927  189C 3E 14                        LD      A,NBSEM
 928  189E 07                           RLCA
 929  189F 07                           RLCA
 930  18A0 07                           RLCA                                ; NBSEM*8 = dónde empiezan los semáforos de E/S
 931  18A1 5F                           LD      E,A
 932  18A2 16 00                        LD      D,0
 933  18A4 DD 19                        ADD     IX,DE
 934  18A6 DD E5                        PUSH    IX
 935  18A8 FD E1                        POP     IY                          ; IY POINTE SEM E/S 0 (la reservada al
 936  18AA                                                      ; time-slicing, ver TACHFON)
 937  18AA
 938  18AA 1E 08                        LD      E,8
 939  18AC 16 00                        LD      D,0
 940  18AE DD 19                        ADD     IX,DE
 941  18B0 21 BE 13                     LD      HL,INREVM
 942  18B3 23                           INC     HL
 943  18B4 06 07                        LD      B,NBES - 1
 944  18B6 0E 01                        LD      C,1                          ; IX POINTE SEM E/S 1
 945  18B8                                                                     ; HL POINTE IND. DE REVEIL
 946  18B8                                                      ; recorre las unidades de E/S 1..NBES-1 (la 0 se trata aparte
 947  18B8                                                      ; más abajo, sólo para time-slicing)
 948  18B8
 949  18B8 DD 7E 05     REVISAR         LD      A,(IX + 5)                   ; EN ATTENTE DE REVEIL ?
 950  18BB FE 00                        CP      FALSE
 951  18BD 28 1B                        JR      Z,SUSEMES                    ; si su watchdog no está activo, sigue con la
 952  18BF                                                      ; siguiente unidad
 953  18BF
 954  18BF DD 5E 06                     LD      E,(IX + 6)                   ; OUI
 955  18C2 DD 56 07                     LD      D,(IX + 7)
 956  18C5 1B                           DEC     DE                           ; decrementa su cuenta regresiva de 16 bits
 957  18C6 DD 73 06                     LD      (IX + 6),E
 958  18C9 DD 72 07                     LD      (IX + 7),D                   ; T.D. ?
 959  18CC 7B                           LD      A,E
 960  18CD B2                           OR      D
 961  18CE 20 0A                        JR      NZ,SUSEMES                   ; ¿llegó a 0?
 962  18D0
 963  18D0 79                           LD      A,C                          ; OUI
 964  18D1 CD 1D 16                     CALL    FINES                        ; REVEIL -> "se acabó el tiempo" de esta unidad:
 965  18D4 36 01                        LD      (HL),TRUE                    ; REVEILLE PAR L'HORLOGE   despierta a quien la
 966  18D6 DD 36 05 00                  LD      (IX + 5),FALSE               ; esperaba y apaga su watchdog
 967  18DA
 968  18DA 23           SUSEMES         INC     HL                           ; CONTINUER A VERIFIER T.D.
 969  18DB 1E 08                        LD      E,8
 970  18DD 16 00                        LD      D,0
 971  18DF DD 19                        ADD     IX,DE
 972  18E1 0C                           INC     C
 973  18E2 10 D4                        DJNZ    REVISAR
 974  18E4
 975  18E4 FD 7E 05                     LD      A,(IY + 5)                   ; TIME SLICING ?
 976  18E7 FE 01                        CP      TRUE
 977  18E9 20 1C                        JR      NZ,FINITH                    ; si el time-slicing no está activo, no hay
 978  18EB                                                      ; nada más que hacer: regresar normal de la interrupción
 979  18EB
 980  18EB FD 5E 06                     LD      E,(IY + 6)                   ; OUI
 981  18EE FD 56 07                     LD      D,(IY + 7)
 982  18F1 1B                           DEC     DE                           ; decrementa el contador de la rebanada de tiempo
 983  18F2 FD 73 06                     LD      (IY + 6),E
 984  18F5 FD 72 07                     LD      (IY + 7),D                   ; FIN TRANCHE ?
 985  18F8 7B                           LD      A,E
