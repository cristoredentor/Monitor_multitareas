 340  15D1              ;***************************************************************************
 341  15D1              ;
 342  15D1              ; PRIMITIVE PASS                    ; PASSE LA MAIN  -> cede la CPU voluntariamente si hay otra
 343  15D1                                                      ; tarea lista; si no hay ninguna, sigue corriendo igual
 344  15D1              ;
 345  15D1              ; SI ON VEUT UTILISER "TIME SLICING", IL FAUT ACTIVER "UNITE E/S #0"
 346  15D1              ; LA ROUTINE DE TRAITEMENT D'IT DE L'HORLOGE FERA PASS POUR QUITTER LE
 347  15D1              ; PROCESSEUR A LA TACHE EN COURS
 348  15D1
 349  15D1              ; traducción: si se quiere usar "time slicing", hay que activar la "unidad
 350  15D1              ; de E/S #0"; la rutina de interrupción del reloj hará PASS para quitarle la
 351  15D1              ; CPU a la tarea en curso.
 352  15D1 F5           PASS            PUSH    AF
 353  15D2 E5                           PUSH    HL
 354  15D3 D5                           PUSH    DE
 355  15D4 C5                           PUSH    BC
 356  15D5 DD E5                        PUSH    IX
 357  15D7 FD E5                        PUSH    IY
 358  15D9
 359  15D9 DD 2A 0C 10                  LD      IX,(PTRTA)               ; REGARDER FILE TACHES PRETES
 360  15DD DD 6E 00                     LD      L,(IX + CHTPMS)          ; IX POINTE TACHE ACTIVE
 361  15E0 DD 66 01                     LD      H,(IX + CHTPMS + 1)      ; HL POINTE SUIVANTE TACHE PRETE
 362  15E3 7D                           LD      A,L
 363  15E4 B4                           OR      H
 364  15E5 20 0A                        JR      NZ,CONPASS
 365  15E7                                                      ; si el "siguiente" de la tarea activa es NIL, no hay
 366  15E7                                                      ; ninguna otra tarea lista: no hace falta cambiar de tarea
 367  15E7
 368  15E7 FD E1        FINPASS         POP     IY                       ; FILE TACHES PRETES VIDE
 369  15E9 DD E1                        POP     IX
 370  15EB C1                           POP     BC
 371  15EC D1                           POP     DE
 372  15ED E1                           POP     HL
 373  15EE F1                           POP     AF
 374  15EF
 375  15EF FB                           EI
 376  15F0 C9                           RET                              ; CONTINUER
 377  15F1
 378  15F1 22 08 10     CONPASS         LD      (PTRDTP),HL              ; EXTRAIRE TETE TACHES PRETES
 379  15F4                                                      ; sí había otra tarea lista: esa pasa a ser la nueva cabeza
 380  15F4
 381  15F4 ED 5B 0C 10                  LD      DE,(PTRTA)
 382  15F8 DD 36 00 00                  LD      (IX + CHTPMS),NIL        ; AJOUTER FIN TACHES PRETES
 383  15FC DD 36 01 00                  LD      (IX + CHTPMS + 1),NIL    ; a la tarea que estaba activa se le agrega al
 384  1600 DD 36 02 01                  LD      (IX + STATUS),PRET       ; final de la cola de listas (vuelve a la fila)
 385  1604 2A 0A 10                     LD      HL,(PTRFTP)
 386  1607 E5                           PUSH    HL
 387  1608 FD E1                        POP     IY                       ; IY POINTE FIN TACHES PRETES
 388  160A FD 73 00                     LD      (IY + CHTPMS),E
 389  160D FD 72 01                     LD      (IY + CHTPMS + 1),D
 390  1610 ED 53 0A 10                  LD      (PTRFTP),DE
 391  1614
 392  1614 C3 A1 15                     JP      DISP                     ; REND LA MAIN -> deja que DISP haga el cambio real
 393  1617
