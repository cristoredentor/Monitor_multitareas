 368  1B4C              ;***************************************************************************
 369  1B4C              ;
 370  1B4C              ; PRIMITIVE PASS                    ; PASSE LA MAIN  -> cede la CPU voluntariamente si hay otra
 371  1B4C                                                      ; tarea lista; si no hay ninguna, sigue corriendo igual
 372  1B4C              ;
 373  1B4C              ; SI ON VEUT UTILISER "TIME SLICING", IL FAUT ACTIVER "UNITE E/S #0"
 374  1B4C              ; LA ROUTINE DE TRAITEMENT D'IT DE L'HORLOGE FERA PASS POUR QUITTER LE
 375  1B4C              ; PROCESSEUR A LA TACHE EN COURS
 376  1B4C
 377  1B4C              ; traducción: si se quiere usar "time slicing", hay que activar la "unidad
 378  1B4C              ; de E/S #0"; la rutina de interrupción del reloj hará PASS para quitarle la
 379  1B4C              ; CPU a la tarea en curso.
 380  1B4C F5           PASS            PUSH    AF
 381  1B4D E5                           PUSH    HL
 382  1B4E D5                           PUSH    DE
 383  1B4F C5                           PUSH    BC
 384  1B50 DD E5                        PUSH    IX
 385  1B52 FD E5                        PUSH    IY
 386  1B54
 387  1B54 DD 2A 0C 10                  LD      IX,(PTRTA)               ; REGARDER FILE TACHES PRETES
 388  1B58 DD 6E 00                     LD      L,(IX + CHTPMS)          ; IX POINTE TACHE ACTIVE
 389  1B5B DD 66 01                     LD      H,(IX + CHTPMS + 1)      ; HL POINTE SUIVANTE TACHE PRETE
 390  1B5E 7D                           LD      A,L
 391  1B5F B4                           OR      H
 392  1B60 20 0A                        JR      NZ,CONPASS
 393  1B62                                                      ; si el "siguiente" de la tarea activa es NIL, no hay
 394  1B62                                                      ; ninguna otra tarea lista: no hace falta cambiar de tarea
 395  1B62
 396  1B62 FD E1        FINPASS         POP     IY                       ; FILE TACHES PRETES VIDE
 397  1B64 DD E1                        POP     IX
 398  1B66 C1                           POP     BC
 399  1B67 D1                           POP     DE
 400  1B68 E1                           POP     HL
 401  1B69 F1                           POP     AF
 402  1B6A
 403  1B6A FB                           EI
 404  1B6B C9                           RET                              ; CONTINUER
 405  1B6C
 406  1B6C 22 08 10     CONPASS         LD      (PTRDTP),HL              ; EXTRAIRE TETE TACHES PRETES
 407  1B6F                                                      ; sí había otra tarea lista: esa pasa a ser la nueva cabeza
 408  1B6F
 409  1B6F ED 5B 0C 10                  LD      DE,(PTRTA)
 410  1B73 DD 36 00 00                  LD      (IX + CHTPMS),NIL        ; AJOUTER FIN TACHES PRETES
 411  1B77 DD 36 01 00                  LD      (IX + CHTPMS + 1),NIL    ; a la tarea que estaba activa se le agrega al
 412  1B7B DD 36 02 01                  LD      (IX + STATUS),PRET       ; final de la cola de listas (vuelve a la fila)
 413  1B7F 2A 0A 10                     LD      HL,(PTRFTP)
 414  1B82 E5                           PUSH    HL
 415  1B83 FD E1                        POP     IY                       ; IY POINTE FIN TACHES PRETES
 416  1B85 FD 73 00                     LD      (IY + CHTPMS),E
 417  1B88 FD 72 01                     LD      (IY + CHTPMS + 1),D
 418  1B8B ED 53 0A 10                  LD      (PTRFTP),DE
 419  1B8F
 420  1B8F C3 1C 1B                     JP      DISP                     ; REND LA MAIN -> deja que DISP haga el cambio real
 421  1B92
