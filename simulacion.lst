 950  1E00 D3 C0                        OUT     (H0),A                     ; VECTEUR IT AU CTC
 951  1E02                                                                   ; L = 0
 952  1E02 3E B7                        LD      A,0B7H
simulacion.asm(953): warning: value 0x7C0 is truncated to 8bit value: 0xC0
 953  1E04 D3 C0                        OUT     (H0),A                      ; MODE D'OPERATION
 954  1E06
 955  1E06 3E 00                        LD      A,0
